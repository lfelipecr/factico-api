{
  "openapi": "3.0.0",
  "info": {
    "title": "API Fáctico Middleware Versión 4.4 — Integradores",
    "description": "Documentación pública para integradores (ERP/POS).\n\n**Credencial del tenant:** header `X-Api-Key` con valor `fc_live_...` (o `Authorization: Bearer fc_live_...`).\n\n**Solo si llamas a la URL `*.supabase.co/functions/v1/...`:** el gateway de Supabase exige además header `apikey` (o `Authorization: Bearer` con la anon key del proyecto). Eso no valida el tenant; solo abre la puerta hasta la Edge Function. En Postman/curl ver `middleware/docs/DEPLOY.md`.\n\nHeader `X-Environment`: `staging` o `production`.\n\n**Odoo directo (form-data):** https://lfelipecr.github.io/apifecrdoc/",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://rabcundgpzfzwnntjuxu.supabase.co/functions/v1/api",
      "description": "Producción"
    }
  ],
  "tags": [
    {
      "name": "1. Clave",
      "description": "Generación de clave numérica y consecutivo (Odoo generate_key)."
    },
    {
      "name": "2. Crear XML",
      "description": "Crea FE, NC, ND, TE, REP, MR, etc. según tipo_documento."
    },
    {
      "name": "3. Firma",
      "description": "Firma del XML con certificado cargado en el panel."
    },
    {
      "name": "4. Hacienda",
      "description": "Envío y consulta ante el Ministerio de Hacienda."
    },
    {
      "name": "5. Descargas",
      "description": "Respaldos XML almacenados en el middleware."
    },
    {
      "name": "6. Proceso completo",
      "description": "Key + XML + firma + envío en un solo paso."
    }
  ],
  "paths": {
    "/v1/documents/key": {
      "post": {
        "tags": [
          "1. Clave"
        ],
        "summary": "Generar clave",
        "description": "Genera clave de 50 dígitos y consecutivo. Incremente secuencia en cada comprobante.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/xml": {
      "post": {
        "tags": [
          "2. Crear XML"
        ],
        "summary": "Crear XML (FE, NC, ND, TE, REP, MR)",
        "description": "Mismos campos que Odoo xml_invoice. Enviar clave y consecutivo del paso 1.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeXmlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/sign": {
      "post": {
        "tags": [
          "3. Firma"
        ],
        "summary": "Firmar xml",
        "description": "Body: comprobante_xml (Base64 del paso 2). Certificado y PIN en credenciales del tenant.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "comprobante_xml"
                ],
                "properties": {
                  "document_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "comprobante_xml": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/send": {
      "post": {
        "tags": [
          "4. Hacienda"
        ],
        "summary": "Hacienda envío",
        "description": "Envía XML firmado. Credenciales ATV en panel si no se envían aquí.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clave",
                  "fecha",
                  "emisor_tipo_identificacion",
                  "emisor_numero_identificacion",
                  "comprobante_xml_firmado"
                ],
                "properties": {
                  "document_id": {
                    "type": "string"
                  },
                  "clave": {
                    "type": "string"
                  },
                  "fecha": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "emisor_tipo_identificacion": {
                    "type": "string"
                  },
                  "emisor_numero_identificacion": {
                    "type": "string"
                  },
                  "receptor_tipo_identificacion": {
                    "type": "string"
                  },
                  "receptor_numero_identificacion": {
                    "type": "string"
                  },
                  "comprobante_xml_firmado": {
                    "type": "string"
                  },
                  "usuario_hacienda": {
                    "type": "string"
                  },
                  "contrasena_hacienda": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/{id}/status": {
      "get": {
        "tags": [
          "4. Hacienda"
        ],
        "summary": "Hacienda consulta",
        "description": "Consulta estado del comprobante en Hacienda por document_id.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/{id}/download/{kind}": {
      "get": {
        "tags": [
          "5. Descargas"
        ],
        "summary": "Descargar respaldo",
        "description": "kind: xml | signed | response",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          },
          {
            "$ref": "#/components/parameters/DownloadKind"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    },
    "/v1/documents/process": {
      "post": {
        "tags": [
          "6. Proceso completo"
        ],
        "summary": "FE completo (key+xml+sign+send)",
        "description": "Un request con campos de key, xml y send.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeXmlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta exitosa"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "FacticoApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key del integrador (`fc_live_...`). Obligatoria en todas las rutas de documentos."
      }
    },
    "parameters": {
      "XEnvironment": {
        "name": "X-Environment",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ],
          "default": "staging"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": {
          "type": "string"
        }
      },
      "DocumentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DownloadKind": {
        "name": "kind",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "xml",
            "signed",
            "response"
          ]
        }
      }
    },
    "schemas": {
      "FeXmlRequest": {
        "type": "object",
        "required": [
          "tipo_documento",
          "clave",
          "consecutivo",
          "proveedor_sistemas",
          "fecha_emision",
          "emisor_nombre",
          "emisor_tipo_identificacion",
          "emisor_numero_identififcacion",
          "receptor_nombre",
          "codigo_actividad_emisor",
          "condicion_venta",
          "plazo_credito",
          "codigo_moneda",
          "detalle_servicio",
          "total_comprobante"
        ],
        "properties": {
          "tipo_documento": {
            "type": "string",
            "description": "FE, NC, ND, TE, REP, MR, FEC, FEE.",
            "example": "FE"
          },
          "clave": {
            "type": "string",
            "description": "50 dígitos. Obtener en paso 1 (generate_key)."
          },
          "consecutivo": {
            "type": "string",
            "description": "20 dígitos. Obtener en paso 1."
          },
          "proveedor_sistemas": {
            "type": "string"
          },
          "fecha_emision": {
            "type": "string",
            "format": "date-time",
            "example": "2025-09-04T10:00:00-06:00"
          },
          "emisor_nombre": {
            "type": "string"
          },
          "emisor_tipo_identificacion": {
            "type": "string",
            "example": "02"
          },
          "emisor_numero_identififcacion": {
            "type": "string",
            "description": "Tres 'f' — typo histórico Odoo."
          },
          "emisor_nombre_comercial": {
            "type": "string"
          },
          "emisor_provincia": {
            "type": "string"
          },
          "emisor_canton": {
            "type": "string"
          },
          "emisor_distrito": {
            "type": "string"
          },
          "emisor_barrio": {
            "type": "string"
          },
          "emisor_otras_senas": {
            "type": "string"
          },
          "emisor_codigo_pais_telefono": {
            "type": "string",
            "example": "506"
          },
          "emisor_telefono": {
            "type": "string"
          },
          "emisor_email": {
            "type": "string"
          },
          "receptor_nombre": {
            "type": "string"
          },
          "receptor_tipo_identificacion": {
            "type": "string"
          },
          "receptor_numero_identificacion": {
            "type": "string"
          },
          "receptor_provincia": {
            "type": "string"
          },
          "receptor_canton": {
            "type": "string"
          },
          "receptor_distrito": {
            "type": "string"
          },
          "receptor_barrio": {
            "type": "string"
          },
          "receptor_otras_senas": {
            "type": "string"
          },
          "receptor_codigo_pais_telefono": {
            "type": "string"
          },
          "receptor_telefono": {
            "type": "string"
          },
          "receptor_email": {
            "type": "string"
          },
          "receptor_nombre_comercial": {
            "type": "string"
          },
          "codigo_actividad_emisor": {
            "type": "string"
          },
          "codigo_actividad_receptor": {
            "type": "string"
          },
          "condicion_venta": {
            "type": "string"
          },
          "condicion_venta_otros": {
            "type": "string"
          },
          "plazo_credito": {
            "type": "string"
          },
          "detalle_servicio": {
            "type": "array",
            "description": "Líneas de detalle (JSON array; en Odoo directo va como string).",
            "items": {
              "type": "object"
            }
          },
          "codigo_moneda": {
            "type": "string",
            "example": "CRC"
          },
          "tipo_cambio": {
            "type": "string",
            "example": "1"
          },
          "total_serv_gravados": {
            "type": "string"
          },
          "total_serv_exentos": {
            "type": "string"
          },
          "total_serv_exonerado": {
            "type": "string"
          },
          "total_serv_no_sujeto": {
            "type": "string"
          },
          "total_merc_gravadas": {
            "type": "string"
          },
          "total_merc_exentas": {
            "type": "string"
          },
          "total_merc_exonerada": {
            "type": "string"
          },
          "total_merc_no_sujeta": {
            "type": "string"
          },
          "total_gravado": {
            "type": "string"
          },
          "total_exento": {
            "type": "string"
          },
          "total_exonerado": {
            "type": "string"
          },
          "total_no_sujeto": {
            "type": "string"
          },
          "total_venta": {
            "type": "string"
          },
          "total_descuentos": {
            "type": "string"
          },
          "total_venta_neta": {
            "type": "string"
          },
          "total_desglose_impuesto": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total_impuesto": {
            "type": "string"
          },
          "total_impuestos_asumidos_fabrica": {
            "type": "string"
          },
          "total_iva_devuelto": {
            "type": "string"
          },
          "total_otros_cargos": {
            "type": "string"
          },
          "medios_pago": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total_comprobante": {
            "type": "string"
          },
          "otros": {
            "type": "string"
          },
          "informacion_referencia": {
            "type": "object",
            "description": "Obligatorio para NC/ND."
          }
        }
      },
      "GenerateKeyRequest": {
        "type": "object",
        "required": [
          "sucursal",
          "terminal",
          "secuencia",
          "tipo_documento",
          "numero_identificacion",
          "situacion",
          "codigo_pais"
        ],
        "properties": {
          "sucursal": {
            "type": "string",
            "example": "001"
          },
          "terminal": {
            "type": "string",
            "example": "00001"
          },
          "secuencia": {
            "type": "string",
            "example": "0000000001"
          },
          "tipo_documento": {
            "type": "string",
            "example": "FE"
          },
          "numero_identificacion": {
            "type": "string"
          },
          "situacion": {
            "type": "string",
            "example": "normal"
          },
          "codigo_pais": {
            "type": "string",
            "example": "506"
          }
        }
      }
    }
  }
}
