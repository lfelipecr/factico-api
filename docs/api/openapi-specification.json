{
  "openapi": "3.0.3",
  "info": {
    "title": "Fáctico Middleware API",
    "version": "1.0.0",
    "description": "API REST multi-tenant para facturación electrónica Costa Rica (v4.4). Los integradores envían **JSON**; el middleware traduce a Odoo (form-data), aplica cuotas y guarda trazabilidad.\n\n## Autenticación (integradores)\n1. Header `X-Api-Key: fc_live_...` (clave del panel).\n2. Header `apikey` o `Authorization: Bearer` con la **anon key** de Supabase (requerido en el gateway de Edge Functions).\n3. Header `X-Environment: staging` o `production`.\n\n## Flujo recomendado\n`key` → `xml` → `sign` → `send` → `status` (o un solo `process`).\n\nDocumentación Odoo directa (form-data): [apifecrdoc](https://lfelipecr.github.io/apifecrdoc/)\n",
    "contact": {
      "name": "Fáctico / Kibu",
      "url": "https://api.kibuinc.com"
    }
  },
  "servers": [
    {
      "url": "https://rabcundgpzfzwnntjuxu.supabase.co/functions/v1/api",
      "description": "Producción (Supabase Edge Functions)"
    },
    {
      "url": "http://127.0.0.1:54321/functions/v1/api",
      "description": "Desarrollo local"
    }
  ],
  "tags": [
    {
      "name": "0. General",
      "description": "Salud y convenciones"
    },
    {
      "name": "1. Documentos (integrador)",
      "description": "Flujo FE con API key `fc_live_`"
    },
    {
      "name": "2. Administración",
      "description": "Panel, provisionamiento y credenciales (JWT o Provision Key)"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "0. General"
        ],
        "summary": "Health check",
        "description": "No requiere API key. Recomendado enviar `apikey` de Supabase.",
        "responses": {
          "200": {
            "description": "Servicio activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/key": {
      "post": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Generar clave y consecutivo",
        "description": "Primer paso del flujo. Crea registro en `documents` y llama Odoo `generate_key`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Clave generada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateKeyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      }
    },
    "/v1/documents/xml": {
      "post": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Crear XML (FE, NC, ND, …)",
        "description": "Requiere `clave` y `consecutivo` del paso **key**. Devuelve XML en Base64.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeXmlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "XML creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      }
    },
    "/v1/documents/sign": {
      "post": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Firmar XML",
        "description": "Usa certificado P12 cargado en el panel. PIN y `codigo_certificado` se toman de credenciales del tenant.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "XML firmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "412": {
            "description": "Credenciales/certificado no configurados"
          }
        }
      }
    },
    "/v1/documents/send": {
      "post": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Enviar a Hacienda",
        "description": "Envía el XML firmado. Credenciales ATV del tenant (panel) si no se envían en el body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado envío",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HaciendaResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      }
    },
    "/v1/documents/process": {
      "post": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Proceso completo (key + xml + sign + send)",
        "description": "Un solo request con todos los campos de FE más opcionales de key/send. Útil para pruebas.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeXmlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del proceso"
          }
        }
      }
    },
    "/v1/documents/{id}/status": {
      "get": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Consultar estado en Hacienda",
        "description": "Consulta MH por `clave` del documento.",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": null,
        "responses": {
          "200": {
            "description": "Estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/documents/{id}/download/{kind}": {
      "get": {
        "tags": [
          "1. Documentos (integrador)"
        ],
        "summary": "Descargar respaldo",
        "description": "`kind`: xml | signed | response (Base64 almacenado).",
        "parameters": [
          {
            "$ref": "#/components/parameters/XEnvironment"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          },
          {
            "$ref": "#/components/parameters/DownloadKind"
          }
        ],
        "security": [
          {
            "SupabaseAnon": []
          },
          {
            "FacticoApiKey": []
          }
        ],
        "requestBody": null,
        "responses": {
          "200": {
            "description": "Contenido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/admin/organizations/provision": {
      "post": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Provisionar tenant",
        "description": "Crea organización, usuario Odoo (o reutiliza), credenciales y API key. Auth: JWT superadmin o `X-Provision-Key`.",
        "security": [
          {
            "BearerJwt": []
          },
          {
            "ProvisionKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/organizations/me": {
      "get": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Mi organización (panel)",
        "security": [
          {
            "BearerJwt": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil y org"
          }
        }
      }
    },
    "/v1/admin/profiles/link-organization": {
      "patch": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Vincular usuario panel a tenant",
        "security": [
          {
            "BearerJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "organization_id"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "organization_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "implementer",
                      "client"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vinculado"
          }
        }
      }
    },
    "/v1/admin/organizations/{id}/credentials": {
      "put": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Actualizar credenciales",
        "security": [
          {
            "BearerJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "environment": {
                    "type": "string",
                    "enum": [
                      "staging",
                      "production"
                    ]
                  },
                  "factico_secret_key": {
                    "type": "string"
                  },
                  "hacienda_user": {
                    "type": "string"
                  },
                  "hacienda_password": {
                    "type": "string"
                  },
                  "certificate_code": {
                    "type": "string"
                  },
                  "certificate_pin": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Actualizado"
          }
        }
      }
    },
    "/v1/admin/organizations/{id}/api-clients": {
      "post": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Crear API key",
        "security": [
          {
            "BearerJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API key creada (mostrada una vez)"
          }
        }
      }
    },
    "/v1/admin/organizations/{id}/certificate": {
      "post": {
        "tags": [
          "2. Administración"
        ],
        "summary": "Subir certificado P12",
        "security": [
          {
            "BearerJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "archivo_p12",
                  "pin"
                ],
                "properties": {
                  "environment": {
                    "type": "string",
                    "enum": [
                      "staging",
                      "production"
                    ]
                  },
                  "pin": {
                    "type": "string"
                  },
                  "archivo_p12": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificado cargado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SupabaseAnon": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Anon/public key del proyecto Supabase (gateway)."
      },
      "FacticoApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key del tenant (`fc_live_...`)."
      },
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Alternativa: `Authorization: Bearer fc_live_...`"
      },
      "BearerJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT de Supabase Auth (panel)."
      },
      "ProvisionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Provision-Key",
        "description": "Clave de servicio para provisionar tenants."
      }
    },
    "parameters": {
      "XEnvironment": {
        "name": "X-Environment",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ],
          "default": "staging"
        },
        "description": "Ambiente Odoo: `staging` → `/cr_api-staging`, `production` → `/cr_api`."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Opcional. Evita duplicar documentos en reintentos."
      },
      "OrganizationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DocumentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DownloadKind": {
        "name": "kind",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "xml",
            "signed",
            "response"
          ]
        }
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "unauthorized"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "odoo_base_url": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GenerateKeyRequest": {
        "type": "object",
        "required": [
          "sucursal",
          "terminal",
          "secuencia",
          "tipo_documento",
          "numero_identificacion",
          "situacion",
          "codigo_pais"
        ],
        "properties": {
          "sucursal": {
            "type": "string",
            "example": "001"
          },
          "terminal": {
            "type": "string",
            "example": "00001"
          },
          "secuencia": {
            "type": "string",
            "example": "0000000001",
            "description": "Incrementar por cada comprobante."
          },
          "tipo_documento": {
            "type": "string",
            "example": "FE",
            "description": "FE, NC, ND, TE, REP, MR, FEC, FEE"
          },
          "numero_identificacion": {
            "type": "string",
            "description": "Cédula del emisor"
          },
          "situacion": {
            "type": "string",
            "example": "normal"
          },
          "codigo_pais": {
            "type": "string",
            "example": "506"
          }
        }
      },
      "GenerateKeyResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "clave": {
            "type": "string"
          },
          "consecutivo": {
            "type": "string"
          }
        }
      },
      "FeXmlRequest": {
        "type": "object",
        "required": [
          "tipo_documento",
          "clave",
          "consecutivo",
          "proveedor_sistemas",
          "fecha_emision",
          "emisor_nombre",
          "emisor_tipo_identificacion",
          "emisor_numero_identififcacion",
          "receptor_nombre",
          "codigo_actividad_emisor",
          "condicion_venta",
          "plazo_credito",
          "codigo_moneda",
          "detalle_servicio",
          "total_comprobante"
        ],
        "description": "Payload JSON para FE. Use los mismos campos que Odoo `xml_invoice`. El campo `emisor_numero_identififcacion` lleva tres 'f' (typo histórico de Odoo).",
        "properties": {
          "tipo_documento": {
            "type": "string",
            "example": "FE"
          },
          "clave": {
            "type": "string"
          },
          "consecutivo": {
            "type": "string"
          },
          "proveedor_sistemas": {
            "type": "string"
          },
          "fecha_emision": {
            "type": "string",
            "example": "2025-09-04T10:00:00-06:00"
          },
          "emisor_nombre": {
            "type": "string"
          },
          "emisor_tipo_identificacion": {
            "type": "string",
            "example": "02"
          },
          "emisor_numero_identififcacion": {
            "type": "string"
          },
          "emisor_nombre_comercial": {
            "type": "string"
          },
          "emisor_provincia": {
            "type": "string"
          },
          "emisor_canton": {
            "type": "string"
          },
          "emisor_distrito": {
            "type": "string"
          },
          "receptor_nombre": {
            "type": "string"
          },
          "receptor_tipo_identificacion": {
            "type": "string"
          },
          "receptor_numero_identificacion": {
            "type": "string"
          },
          "codigo_actividad_emisor": {
            "type": "string"
          },
          "condicion_venta": {
            "type": "string"
          },
          "plazo_credito": {
            "type": "string"
          },
          "codigo_moneda": {
            "type": "string",
            "example": "CRC"
          },
          "tipo_cambio": {
            "type": "string",
            "example": "1"
          },
          "detalle_servicio": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total_desglose_impuesto": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "medios_pago": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total_serv_gravados": {
            "type": "string"
          },
          "total_serv_exentos": {
            "type": "string"
          },
          "total_merc_gravadas": {
            "type": "string"
          },
          "total_gravado": {
            "type": "string"
          },
          "total_venta": {
            "type": "string"
          },
          "total_impuesto": {
            "type": "string"
          },
          "total_comprobante": {
            "type": "string"
          }
        }
      },
      "XmlResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "clave": {
            "type": "string"
          },
          "consecutivo": {
            "type": "string"
          },
          "xml": {
            "type": "string",
            "description": "XML en Base64"
          }
        }
      },
      "SignRequest": {
        "type": "object",
        "required": [
          "comprobante_xml"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "comprobante_xml": {
            "type": "string",
            "description": "XML Base64 del paso xml"
          }
        }
      },
      "SignResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "comprobante_xml_firmado": {
            "type": "string",
            "description": "XML firmado Base64"
          }
        }
      },
      "SendRequest": {
        "type": "object",
        "required": [
          "clave",
          "fecha",
          "emisor_tipo_identificacion",
          "emisor_numero_identificacion",
          "comprobante_xml_firmado"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "clave": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "emisor_tipo_identificacion": {
            "type": "string"
          },
          "emisor_numero_identificacion": {
            "type": "string"
          },
          "receptor_tipo_identificacion": {
            "type": "string"
          },
          "receptor_numero_identificacion": {
            "type": "string"
          },
          "comprobante_xml_firmado": {
            "type": "string"
          },
          "usuario_hacienda": {
            "type": "string",
            "description": "Opcional si está en credenciales del tenant"
          },
          "contrasena_hacienda": {
            "type": "string"
          }
        }
      },
      "HaciendaResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "codigo_estado": {
            "type": "integer"
          },
          "estado": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "local_status": {
            "type": "string",
            "description": "accepted, rejected, processing, sent, signed, xml_created"
          },
          "codigo_estado": {
            "type": "integer"
          },
          "estado": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "clave": {
            "type": "string"
          },
          "respuesta_xml": {
            "type": "string",
            "description": "Respuesta MH Base64"
          }
        }
      },
      "DownloadResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "content_base64": {
            "type": "string"
          }
        }
      },
      "ProvisionRequest": {
        "type": "object",
        "required": [
          "organization",
          "odoo_user"
        ],
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "staging",
              "production"
            ],
            "default": "staging"
          },
          "organization": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "tax_id": {
                "type": "string"
              }
            }
          },
          "odoo_user": {
            "type": "object",
            "required": [
              "usuario_nombre",
              "codigo_identificacion",
              "numero_identificacion",
              "correo"
            ],
            "properties": {
              "usuario_nombre": {
                "type": "string"
              },
              "codigo_identificacion": {
                "type": "string",
                "description": "cedula_fisica, cedula_juridica, dimex, nite, extranjero"
              },
              "numero_identificacion": {
                "type": "string"
              },
              "correo": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "hacienda": {
            "type": "object",
            "properties": {
              "usuario_hacienda": {
                "type": "string"
              },
              "contrasena_hacienda": {
                "type": "string"
              }
            }
          },
          "api_client_name": {
            "type": "string"
          }
        }
      },
      "ProvisionResponse": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "factico_secret_key": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "example": "fc_live_..."
          },
          "odoo_state": {
            "type": "string"
          },
          "odoo_user_reused": {
            "type": "boolean"
          },
          "warning": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "API key o JWT inválido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      },
      "QuotaExceeded": {
        "description": "Cuota del plan excedida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      }
    }
  }
}
