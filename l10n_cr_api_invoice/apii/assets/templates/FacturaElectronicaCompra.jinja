<FacturaElectronicaCompra
        xmlns="https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/facturaElectronicaCompra"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Clave>{{ data['clave'] }}</Clave>
    <ProveedorSistemas>{{ data['proveedor_sistemas'] }}</ProveedorSistemas>
    <CodigoActividadReceptor>{{ data['codigo_actividad_receptor'] }}</CodigoActividadReceptor>
    <NumeroConsecutivo>{{ data['consecutivo'] }}</NumeroConsecutivo>
    <FechaEmision>{{ data['fecha_emision'] }}</FechaEmision>
    <Emisor>
        <Nombre>{{ data['emisor_nombre'] }}</Nombre>
        <Identificacion>
            <Tipo>{{ data['emisor_tipo_identificacion'] }}</Tipo>
            <Numero>{{ data['emisor_numero_identififcacion'] }}</Numero>
        </Identificacion>
        {% if data['emisor_provincia'] and data['emisor_canton'] and data['emisor_distrito'] %}
        <Ubicacion>
            <Provincia>{{ data['emisor_provincia'] }}</Provincia>
            <Canton>{{ data['emisor_canton'] }}</Canton>
            <Distrito>{{ data['emisor_distrito'] }}</Distrito>
            {% if data['emisor_barrio'] %}
            <Barrio>{{ data['emisor_barrio'] }}</Barrio>
            {% endif %}
            {% if data['emisor_otras_senas'] %}
            <OtrasSenas>{{ data['emisor_otras_senas'] }}</OtrasSenas>
            {% endif %}
        </Ubicacion>
        {% endif %}
        {% if data['emisor_otras_senas_extranjero'] %}
        <OtrasSenasExtranjero>{{ data['emisor_otras_senas_extranjero'] }}</OtrasSenasExtranjero>
        {% endif %}
        {% if data['emisor_codigo_pais_telefono'] and data['emisor_telefono'] %}
        <Telefono>
            <CodigoPais>{{ data['emisor_codigo_pais_telefono'] }}</CodigoPais>
            <NumTelefono>{{ data['emisor_telefono'] }}</NumTelefono>
        </Telefono>
        {% endif %}
        {% if data['emisor_email'] %}
        <CorreoElectronico>{{ data['emisor_email'] }}</CorreoElectronico>
        {% endif %}
    </Emisor>
    <Receptor>
        <Nombre>{{ data['receptor_nombre'] }}</Nombre>
        {% if data['receptor_tipo_identificacion'] and data['receptor_numero_identificacion'] %}
        <Identificacion>
            <Tipo>{{ data['receptor_tipo_identificacion'] }}</Tipo>
            <Numero>{{ data['receptor_numero_identificacion'] }}</Numero>
        </Identificacion>
        {% endif %}
        {% if data['receptor_provincia'] and data['receptor_canton'] and data['receptor_distrito'] %}
        <Ubicacion>
            {% if data['receptor_provincia'] %}
            <Provincia>{{ data['receptor_provincia'] }}</Provincia>
            {% endif %}
            {% if data['receptor_canton'] %}
            <Canton>{{ data['receptor_canton'] }}</Canton>
            {% endif %}
            {% if data['receptor_distrito'] %}
            <Distrito>{{ data['receptor_distrito'] }}</Distrito>
            {% endif %}
            {% if data['receptor_barrio'] %}
            <Barrio>{{ data['receptor_barrio'] }}</Barrio>
            {% endif %}
            {% if data['receptor_otras_senas'] %}
            <OtrasSenas>{{ data['receptor_otras_senas'] }}</OtrasSenas>
            {% endif %}
        </Ubicacion>
        {% endif %}
        {% if data['receptor_codigo_pais_telefono'] and data['receptor_telefono'] %}
        <Telefono>
            <CodigoPais>{{ data['receptor_codigo_pais_telefono'] }}</CodigoPais>
            <NumTelefono>{{ data['receptor_telefono'] }}</NumTelefono>
        </Telefono>
        {% endif %}
        {% if data['receptor_email'] %}
        <CorreoElectronico>{{ data['receptor_email'] }}</CorreoElectronico>
        {% endif %}
    </Receptor>
    <CondicionVenta>{{ data['condicion_venta'] }}</CondicionVenta>
    <PlazoCredito>{{ data['plazo_credito'] }}</PlazoCredito>
    <DetalleServicio>
        {% for linea in data['detalle_servicio'] %}
        <LineaDetalle>
            <NumeroLinea>{{ linea['numero_linea'] }}</NumeroLinea>
            <CodigoCABYS>{{ linea['codigo_cabys'] }}</CodigoCABYS>
            {% for codigo_comercial in linea['codigo_comercial'] %}
            <CodigoComercial>
                <Tipo>{{ codigo_comercial['tipo'] }}</Tipo>
                <Codigo>{{ codigo_comercial['codigo'] }}</Codigo>
            </CodigoComercial>
            {% endfor %}
            <Cantidad>{{ linea['cantidad'] }}</Cantidad>
            <UnidadMedida>{{ linea['unidad_medida'] }}</UnidadMedida>
            <TipoTransaccion>{{ linea['tipo_transaccion'] }}</TipoTransaccion>
            <Detalle>{{ linea['detalle'] }}</Detalle>
            <PrecioUnitario>{{ linea['precio_unitario'] }}</PrecioUnitario>
            <MontoTotal>{{ linea['monto_total'] }}</MontoTotal>
            {% if linea['descuento'] and linea['descuento']['aplica'] in ['si', 'SI', 'Si'] %}
            <Descuento>
                <MontoDescuento>{{ linea['descuento']['monto_descuento'] }}</MontoDescuento>
                <CodigoDescuento>{{ linea['descuento']['codigo_descuento'] }}</CodigoDescuento>
                <NaturalezaDescuento>{{ linea['descuento']['naturaleza_descuento'] }}</NaturalezaDescuento>
            </Descuento>
            {% endif %}
            <SubTotal>{{ linea['sub_total'] }}</SubTotal>
            <BaseImponible>{{ linea['base_imponible'] }}</BaseImponible>
            {% for impuesto in linea['impuesto'] %}
            <Impuesto>
                <Codigo>{{ impuesto['codigo'] }}</Codigo>
                <CodigoTarifaIVA>{{ impuesto['codigo_tarifa_iva'] }}</CodigoTarifaIVA>
                <Tarifa>{{ impuesto['tarifa'] }}</Tarifa>
                <Monto>{{ impuesto['monto'] }}</Monto>
                {% if impuesto['exoneracion'] %}
                <Exoneracion>
                    <TipoDocumentoEX1>{{ impuesto['exoneracion']['tipo_documento'] }}</TipoDocumentoEX1>
                    <NumeroDocumento>{{ impuesto['exoneracion']['numero_documento'] }}</NumeroDocumento>
                    <Articulo>{{ impuesto['exoneracion']['articulo'] }}</Articulo>
                    <Inciso>{{ impuesto['exoneracion']['inciso'] }}</Inciso>
                    <NombreInstitucion>{{ impuesto['exoneracion']['nombre_institucion'] }}</NombreInstitucion>
                    <FechaEmisionEX>{{ impuesto['exoneracion']['fecha_emision'] }}</FechaEmisionEX>
                    <TarifaExonerada>{{ impuesto['exoneracion']['porcentaje_exoneracion'] }}</TarifaExonerada>
                    <MontoExoneracion>{{ impuesto['exoneracion']['monto_exoneracion'] }}</MontoExoneracion>
                </Exoneracion>
                {% endif %}
            </Impuesto>
            {% endfor %}
            <ImpuestoNeto>{{ linea['impuesto_neto'] }}</ImpuestoNeto>
            <MontoTotalLinea>{{ linea['monto_total_linea'] }}</MontoTotalLinea>
        </LineaDetalle>
        {% endfor %}
    </DetalleServicio>
    {% if data['otros_cargos'] %}
    <OtrosCargos>
        <TipoDocumentoOC>{{ data['otros_cargos']['tipo_document_oc'] }}</TipoDocumentoOC>
        <Detalle>{{ data['otros_cargos']['detalle'] }}</Detalle>
        <PorcentajeOC>{{ data['otros_cargos']['porcentaje_oc'] }}</PorcentajeOC>
        <MontoCargo>{{ data['otros_cargos']['monto_cargo'] }}</MontoCargo>
    </OtrosCargos>
    {% endif %}
    <ResumenFactura>
        <CodigoTipoMoneda>
            <CodigoMoneda>{{ data['codigo_moneda'] }}</CodigoMoneda>
            <TipoCambio>{{ data['tipo_cambio'] }}</TipoCambio>
        </CodigoTipoMoneda>
        <TotalServGravados>{{ data['total_serv_gravados'] }}</TotalServGravados>
        <TotalServExentos>{{ data['total_serv_exentos'] }}</TotalServExentos>
        <TotalServExonerado>{{ data['total_serv_exonerado'] }}</TotalServExonerado>
        <TotalServNoSujeto>{{ data['total_serv_no_sujeto'] }}</TotalServNoSujeto>
        <TotalMercanciasGravadas>{{ data['total_merc_gravadas'] }}</TotalMercanciasGravadas>
        <TotalMercanciasExentas>{{ data['total_merc_exentas'] }}</TotalMercanciasExentas>
        <TotalMercExonerada>{{ data['total_merc_exonerada'] }}</TotalMercExonerada>
        <TotalMercNoSujeta>{{ data['total_merc_no_sujeta'] }}</TotalMercNoSujeta>
        <TotalGravado>{{ data['total_gravado'] }}</TotalGravado>
        <TotalExento>{{ data['total_exento'] }}</TotalExento>
        <TotalExonerado>{{ data['total_exonerado'] }}</TotalExonerado>
        <TotalNoSujeto>{{ data['total_no_sujeto'] }}</TotalNoSujeto>
        <TotalVenta>{{ data['total_venta'] }}</TotalVenta>
        <TotalDescuentos>{{ data['total_descuentos'] }}</TotalDescuentos>
        <TotalVentaNeta>{{ data['total_venta_neta'] }}</TotalVentaNeta>
        {% for total_desglose_impuesto in data['total_desglose_impuesto'] %}
        <TotalDesgloseImpuesto>
            <Codigo>{{ total_desglose_impuesto['codigo'] }}</Codigo>
            <CodigoTarifaIVA>{{ total_desglose_impuesto['codigo_tarifa_iva'] }}</CodigoTarifaIVA>
            <TotalMontoImpuesto>{{ total_desglose_impuesto['total_monto_impuesto'] }}</TotalMontoImpuesto>
        </TotalDesgloseImpuesto>
        {% endfor %}
        <TotalImpuesto>{{ data['total_impuesto'] }}</TotalImpuesto>
        <TotalOtrosCargos>{{ data['total_otros_cargos'] }}</TotalOtrosCargos>
        {% for medio_pago in data['medios_pago'] %}
        <MedioPago>
            <TipoMedioPago>{{ medio_pago['tipo_medio_pago'] }}</TipoMedioPago>
            <TotalMedioPago>{{ medio_pago['total_medio_pago'] }}</TotalMedioPago>
        </MedioPago>
        {% endfor %}
        <TotalComprobante>{{ data['total_comprobante'] }}</TotalComprobante>
    </ResumenFactura>
    {% for ref_info in data['informacion_referencia'] %}
    {% if ref_info %}
    <InformacionReferencia>
        <TipoDocIR>{{ ref_info['tipo_doc_ir'] }}</TipoDocIR>
        <Numero>{{ ref_info['numero'] }}</Numero>
        <FechaEmisionIR>{{ ref_info['fecha_emision_ir'] }}</FechaEmisionIR>
        <Codigo>{{ ref_info['codigo'] }}</Codigo>
        <Razon>{{ ref_info['razon'] }}</Razon>
    </InformacionReferencia>
    {% endif %}
    {% endfor %}
     <Otros>
        <OtroTexto>{{ data['otros'] }}</OtroTexto>
    </Otros>
</FacturaElectronicaCompra>
