<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cr_api_sequence_list" model="ir.ui.view">
        <field name="name">cr.api.sequence.list</field>
        <field name="model">cr.api.sequence</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="document_type_id" optional="show"/>
                <field name="sequence_id" optional="show"/>
                <field name="sequence_number_next_actual" optional="show"/>
                <field name="api_user_id" optional="hide"/>
                <field name="api_user_mode" optional="hide"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_cr_api_sequence" model="ir.actions.act_window">
        <field name="name">Secuencias</field>
        <field name="res_model">cr.api.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cr_api_sequence_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añadir nueva secuencia
            </p>
        </field>
    </record>
</odoo>
