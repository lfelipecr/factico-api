<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cr_api_identification_type_list" model="ir.ui.view">
        <field name="name">cr.api.identification.type.list</field>
        <field name="model">cr.api.identification.type</field>
        <field name="arch" type="xml">
             <list editable="bottom" create="0" delete="1">
                    <field name="code" string="Código hacienda"/>
                    <field name="code_api" optional="show"/>
                    <field name="name" optional="show"/>
                    <field name="notes" optional="hide"/>
                </list>
        </field>
    </record>

    <record id="action_cr_api_identification_type" model="ir.actions.act_window">
        <field name="name">Tipos de Identificación</field>
        <field name="res_model">cr.api.identification.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cr_api_identification_type_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añadir nuevo tipo de identificación
            </p>
        </field>
    </record>
</odoo>
