# Copiar a .env para desarrollo local (supabase functions serve --env-file .env)
# En Supabase Cloud: configurar como Secrets (Dashboard → Edge Functions → Secrets)

# URL y service role (local: supabase status | cloud: Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clave larga para provisionar tenants (header X-Provision-Key o body provision_key hacia Odoo)
PROVISION_SERVICE_KEY=change-me-to-a-long-random-string

# Base Odoo (sin barra final)
ODOO_BASE_URL=https://api.kibuinc.com
