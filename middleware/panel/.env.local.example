# Copiar a .env.local (panel Next.js)

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Desarrollo: Edge Function directa (sin barra final)
NEXT_PUBLIC_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api

# Opcional: probar proxy local en http://localhost:3000/v1/...
# NEXT_PUBLIC_API_URL=http://localhost:3000
# SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
# SUPABASE_ANON_KEY=your-anon-key
